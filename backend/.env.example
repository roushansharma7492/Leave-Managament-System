# Backend environment variables for Render or other deployment
# Public port is provided by the host via PORT
PORT=8080

# Allowed CORS origins for your frontend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://<your-frontend>.vercel.app

# JWT secret for token signing/validation
JWT_SECRET=change-this-to-a-secure-random-value

# Optional external database configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:employee_leave_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
