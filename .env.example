# Environment Variables Example for Render Deployment
# Copy these to your Render dashboard

DATABASE_URL=mysql://leave_user:password@host:3306/employee_leave_db
DATABASE_USER=leave_user
DATABASE_PASSWORD=your-secure-password
SPRING_PROFILES_ACTIVE=render
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
JWT_SECRET=your-very-secure-jwt-secret-key-min-32-chars
PORT=8080
